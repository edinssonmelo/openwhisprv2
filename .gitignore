.DS_Store
node_modules/
dist/
dist-electron/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.*
!.env.example

# Local tooling and heavy vendored builds (whisper.cpp lives here after setup)
.local/
.venv-asr/
.venv-qwen-asr/

# Recordings and benchmarks (keep repo small)
recordings/*.wav
recordings/*.mp3
recordings/*.m4a
recordings/tmp/
recordings/benchmarks/

# Python bytecode (legacy scripts removed; prevents stray commits)
**/__pycache__/

# Cursor / IDE (optional local state)
.cursor/
.vscode/*
!.vscode/extensions.json

# LLM session memory (not part of the product)
memory-bank/
tools/macos-asr-helper/.build/

# Native build caches and generated distributions (keep local, never commit)
**/.build/
**/.swiftpm/
release/
landing/.vite/
.venv*/

# Private meeting content and generated runtime databases
recordings/**
!recordings/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.dmg
*.blockmap
